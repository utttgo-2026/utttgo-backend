{
  "$schema": "https://stryker-mutator.github.io/stryker-schema/",
  "stryker-config": {
    "test-projects": [
      "../../tests/UtttGo.UnitTests/UtttGo.UnitTests.csproj",
      "../../tests/UtttGo.IntegrationTests/UtttGo.IntegrationTests.csproj"
    ],
    "thresholds": {
      "break": 0,
      "high": 80,
      "low": 60
    },
    "reporters": ["json", "progress"],
    "concurrency": 2,
    "mutate": [
      "**/*.cs",
      "!**/Contracts/**/*.cs",
      "!**/Controllers/**/*.cs",
      "!**/Program.cs",
      "!**/Infrastructure/*Mongo*.cs",
      "!**/Infrastructure/*S3*.cs",
      "!**/bin/**/*.cs",
      "!**/obj/**/*.cs",
      "!**/*.g.cs",
      "!**/*.generated.cs"
    ],
    "ignore-mutations": []
  }
}
