{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "AuthRegister": { "Limit": 5, "WindowSeconds": 900 },
    "AuthLoginIp": { "Limit": 10, "WindowSeconds": 900 },
    "AuthLoginEmail": { "Limit": 5, "WindowSeconds": 900 },
    "PublicSeller": { "Limit": 60, "WindowSeconds": 60 },
    "AdminUsers": { "Limit": 30, "WindowSeconds": 60 },
    "Health": { "Limit": 120, "WindowSeconds": 60 }
  }
}
